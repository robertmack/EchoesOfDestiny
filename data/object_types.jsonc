// ============================================================================
// OBJECT DEFINITIONS
// ============================================================================
//
// This file uses JSONC: ordinary JSON plus comments.
//
// LOADING RULES
// ---------------------------------------------------------------------------
// 1. Start with "_defaults" for every object.
// 2. Apply the matching object definition as an override.
// 3. Forms may override fields inherited from their parent object.
// 4. If an object ID has no entry in "object_types", use "_defaults" and derive:
//        id   = requested object ID
//        name = title-cased object ID
//        kind = "OBJECT"
// 5. Arrays and nested objects are replaced unless the loader explicitly performs
//    a deeper merge. "interactions" should be merged by interaction group.
//
// STANDARD OBJECT TEMPLATE
// ---------------------------------------------------------------------------
// {
//     "id": "object_id",                 // required for listed definitions
//     "name": "Display Name",            // optional; derived from id if omitted
//     "kind": "OBJECT",                  // optional; default: "OBJECT"
//
//     "blocks_movement": false,           // optional; default: false
//     "blocks_vision": false,             // optional; default: false
//     "mobility": "fixed",                // optional; default: "fixed"
//     "footprint": [1, 1],                // optional; [width, height] in tiles
//
//     "traits": [],                       // optional gameplay classifications
//     "interactions": {},                 // optional interaction groups
//
//     "descriptions": {},                 // optional condition/form descriptions
//     "state_fields": [],                 // optional per-instance state names
//     "state_defaults": {},               // optional initial values for missing state
//     "sprite_overlays": [],              // optional state-driven transparent layers
//     "states": [],                       // optional named sprite/operating states
//     "capacity": {},                     // optional resource/container capacity
//     "condition_recovery": {},           // optional signed condition recovery
//     "default_variant": "variant_id",    // optional
//     "variants": [],                     // optional
//     "forms": {},                        // optional persistent transformations
//     "growth": {},                       // optional growth parameters
//     "spawn_tiles": [],                  // optional world-generation restriction
//     "spawn_influence": [],              // optional nearby-spawn influence
//     "build_duration_seconds": 0.0,      // optional
//     "build_cost": {}                    // optional
// }
//
// SPRITE FILE NAMING
// ---------------------------------------------------------------------------
// Object sprites are discovered in src/assets/sprites/objects. Do not put
// sprite paths or filenames in this catalog.
//
// Canonical filename:
//   <object-type>[_<form>][_<variant>][_<state>][_f-<flavor>].png
//
// Rules:
// - The first component is always the stable object type ID.
// - Add only modifiers that apply to the rendered entity.
// - Omit the default form and any missing/default modifier.
// - Form precedes variant; state follows variant; flavor is always last.
// - Flavor uses the literal "_f-" prefix and is cosmetic only.
// - Resolution falls back toward the base object asset when a more-specific
//   filename does not exist.
// - Files that do not follow this convention are ignored by the game.
// - Unrotated multi-tile artwork is authored in E/W orientation. N/S instances
//   are rotated by the renderer.
//
// Examples:
//   tree.png
//   tree_stump.png
//   tree_oak.png
//   tree_stump_oak.png
//   tree_stump_oak_burning.png
//   tree_stump_oak_burning_f-hollow.png
//
// INTERACTION FORMAT
// ---------------------------------------------------------------------------
// "interactions": {
//     "harvest": [
//         {
//             "id": "fell",                       // required within its group
//             "label": "Chop Down Tree",          // optional; derived from id
//             "availability": "condition_id",     // optional
//             "requires": {
//                 "item_trait": "chopping_item",
//                 "carried_type": "object_id",
//                 "player": {}
//             },
//             "duration_seconds": {
//                 "base": 6.0,
//                 "with_basket": 2.0
//             },
//             "cost": {},
//             "water_cost": 0,
//             "loot": {},                         // amount or inclusive [min, max]
//             "creates": {},
//             "result_form": "stump",
//             "variants": []
//         }
//     ]
// }
//
// Standard interaction groups currently used here:
// pickup, sleep, eat, cook, craft, store, take, fill, pour, harvest, use
//
// ============================================================================
{
