                    {"minimum": 25, "text": "bruised", "color": [218, 194, 112], "font": "plain"},
                    {"minimum": 50, "text": "traumatized", "color": [230, 151, 78], "font": "bold"},
                    {"minimum": 75, "text": "badly traumatized", "color": [235, 112, 76], "font": "bold"},
