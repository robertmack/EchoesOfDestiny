          "tilled_today",
          "soil_persistence_percentage",
          "kind_override",
          "persistence_modifier"
        ],
        "progress_per_till": 5.0,
        "persistence_gain_per_conversion": 2.0,
        "reverted_till_progress_range": [
          90.0,
          99.0
